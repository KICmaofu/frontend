# ── 生产环境变量: npm run build / npm run preview 时加载 ─────
# 构建时这些变量会被"编译"进产物(字符串替换), 改完要重新 build 才生效

# 接口基础地址: 生产环境没有 dev server, server.proxy 不生效
# 同域部署(nginx 把 /api 反代到后端)时保持相对路径;
# 前后端不同域时改成完整后端地址, 如 https://api.example.com
VITE_API_BASE_URL=/api

# 是否生成 sourcemap: 默认关闭, 不把源码交给浏览器;
# 需要排查线上问题(如接入 Sentry)时改成 true 重新构建
VITE_BUILD_SOURCEMAP=false
