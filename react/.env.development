# ── 开发环境变量: npm run dev 时加载(vite --mode development) ─

# 接口基础地址: src/api/request.ts 里 axios 实例的 baseURL
# 开发环境填相对路径 /api, 请求先发到 dev server, 再由下面的 mock 或代理接管
VITE_API_BASE_URL=/api

# 是否启用本地 mock(根目录 mock-api.ts 的 Vite 插件)
# true: 由 mock 插件直接响应 /api/* 请求, 不需要真实后端
# false: 走下面的 server.proxy 代理, 联调真实后端
VITE_USE_MOCK=true

# 代理目标: 仅当 VITE_USE_MOCK=false 时生效(见 vite.config.ts 的 server.proxy)
VITE_API_PROXY_TARGET=http://localhost:8080
